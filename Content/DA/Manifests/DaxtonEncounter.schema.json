{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentId", "fingerprint", "leaderAssetPath", "phases", "leaderStates", "characterImports"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contentId": {"const": "encounter.daxton_rhe.final"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "leaderAssetPath": {"const": "/Game/DA/Leaders/DA_Leader_DaxtonRhe"},
    "phases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mechanics"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "mechanics": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "leaderStates": {
      "const": ["Governor", "IndustrialAdvisor", "AlliedForgeLord", "Exile", "Prisoner", "Dead"]
    },
    "characterImports": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetPath", "sourcePath", "assetClass"],
        "properties": {
          "assetPath": {"type": "string", "pattern": "^/Game/Characters/Daxton/[A-Za-z0-9_/]+$"},
          "sourcePath": {"type": "string", "pattern": "^ContentSource/Characters/Daxton/[A-Za-z0-9_]+\\.fbx$"},
          "assetClass": {"enum": ["SkeletalMesh", "AnimSequence"]}
        }
      }
    }
  }
}
