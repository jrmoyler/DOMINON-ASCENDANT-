{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "campaignId", "fingerprint", "quests"],
  "properties": {
    "schemaVersion": {"const": 1},
    "campaignId": {"const": "campaign.vertical_slice.forgeweave_conquest"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "quests": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "assetPath", "citizenIds", "trigger", "choices", "systems",
          "outcomeTags", "choiceOutcomeTags", "dialogueConditions", "requirements", "nodes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "assetPath": {"type": "string", "pattern": "^/Game/DA/Quests/Q_[A-Za-z0-9]+$"},
          "citizenIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "trigger": {"type": "string", "minLength": 1},
          "choices": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "systems": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "outcomeTags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "choiceOutcomeTags": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
          "dialogueConditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "requirements": {"type": "object"},
          "nodes": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "edges"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "type": {"type": "string", "minLength": 1},
                "edges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["branch", "target"],
                    "properties": {
                      "branch": {"type": "string", "minLength": 1},
                      "target": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
