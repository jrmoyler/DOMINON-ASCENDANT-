{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Presentation artifact import and generation sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "primary", "vfx", "audio", "sequences"],
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sourcePath": {"type": "string", "pattern": "^ContentSource/"},
    "assetPath": {"type": "string", "pattern": "^/Game/"}
  },
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceId": {"const": "presentation.artifact_sources.v11"},
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meshSourcePath", "meshSourceSha1", "meshClass", "materialSourcePath", "materialSourceSha1", "materialClass"],
      "properties": {
        "meshSourcePath": {"$ref": "#/$defs/sourcePath"},
        "meshSourceSha1": {"$ref": "#/$defs/sha1"},
        "meshClass": {"const": "StaticMesh"},
        "materialSourcePath": {"$ref": "#/$defs/sourcePath"},
        "materialSourceSha1": {"$ref": "#/$defs/sha1"},
        "materialClass": {"const": "MaterialInstanceConstant"}
      }
    },
    "vfx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemSourcePath", "systemSourceSha1", "systemClass"],
      "properties": {
        "systemSourcePath": {"$ref": "#/$defs/sourcePath"},
        "systemSourceSha1": {"$ref": "#/$defs/sha1"},
        "systemClass": {"const": "NiagaraSystem"}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waveSourcePath", "waveSourceSha1", "waveClass", "cueClass"],
      "properties": {
        "waveSourcePath": {"$ref": "#/$defs/sourcePath"},
        "waveSourceSha1": {"$ref": "#/$defs/sha1"},
        "waveClass": {"const": "SoundWave"},
        "cueClass": {"const": "SoundCue"}
      }
    },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assetPath", "assetClass", "sourcePath", "sourceSha1", "generatorOwner"],
        "properties": {
          "id": {"type": "string", "pattern": "^sequence\\."},
          "assetPath": {"$ref": "#/$defs/assetPath"},
          "assetClass": {"const": "LevelSequence"},
          "sourcePath": {"$ref": "#/$defs/sourcePath"},
          "sourceSha1": {"$ref": "#/$defs/sha1"},
          "generatorOwner": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
