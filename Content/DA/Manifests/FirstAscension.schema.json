{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentId", "fingerprint", "quest", "doctrine", "fusion", "forgeweaveDefinitionIds", "buildingImports", "cinematic"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contentId": {"const": "ascension.forgeweave.first"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "quest": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "assetPath", "completionHistory"],
      "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "assetPath": {"type": "string"}, "completionHistory": {"type": "string"}}
    },
    "doctrine": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "assetPath", "cadenceDevelopmentCycles"],
      "properties": {"id": {"type": "string"}, "assetPath": {"type": "string"}, "cadenceDevelopmentCycles": {"const": 12}}
    },
    "fusion": {
      "type": "object", "additionalProperties": false,
      "required": ["definitionId", "assetPath", "constructionCycles", "craftCapital", "craftInsight", "requiredCraftingFacilityId", "utilityPower", "utilityData", "workforceRequirementModifier", "industrialThroughputModifier", "adjacentIndustrialConstructionSpeedModifier", "dependencyPerCycle", "resourceHungerPerCycle"],
      "properties": {
        "definitionId": {"type": "string"}, "assetPath": {"type": "string"},
        "constructionCycles": {"const": 8}, "craftCapital": {"const": 80},
        "craftInsight": {"const": 0}, "requiredCraftingFacilityId": {"const": "forgeweave.replication_forge"},
        "utilityPower": {"const": 24}, "utilityData": {"const": 24},
        "workforceRequirementModifier": {"const": -0.8}, "industrialThroughputModifier": {"const": 0.25},
        "adjacentIndustrialConstructionSpeedModifier": {"const": 0.15}, "dependencyPerCycle": {"const": 0.2},
        "resourceHungerPerCycle": {"const": 0.15}
      }
    },
    "forgeweaveDefinitionIds": {"type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": {"type": "string"}},
    "buildingImports": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["assetPath", "sourcePath", "assetClass"], "properties": {"assetPath": {"type": "string"}, "sourcePath": {"type": "string"}, "assetClass": {"enum": ["StaticMesh", "Texture2D"]}}}},
    "cinematic": {"type": "object", "additionalProperties": false, "required": ["assetPath", "shotSourcePath", "gameplayGate"], "properties": {"assetPath": {"type": "string"}, "shotSourcePath": {"type": "string"}, "gameplayGate": {"const": false}}}
  }
}
