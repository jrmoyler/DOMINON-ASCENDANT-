{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.6 primary building recipes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceId",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceId": {
      "const": "presentation.primary.buildings.v06"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "id",
          "displayName",
          "faction",
          "kind",
          "assetPath",
          "recipe"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "id": {
            "type": "string",
            "pattern": "^primary\\.[0-9]{2}\\.[a-z0-9_]+$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "faction": {
            "enum": [
              "Synara",
              "Forgeweave",
              "EdenCircuit",
              "Universal",
              "Player",
              "Fusion"
            ]
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "assetPath": {
            "type": "string",
            "pattern": "^/Game/Buildings/"
          },
          "recipe": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "silhouette",
              "materials",
              "signatureElements",
              "constructionGrammar",
              "damageLanguage",
              "requiredStates"
            ],
            "properties": {
              "silhouette": {
                "type": "string",
                "minLength": 1
              },
              "materials": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "signatureElements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "constructionGrammar": {
                "type": "string",
                "pattern": "^construction\\."
              },
              "damageLanguage": {
                "type": "string",
                "pattern": "^damage\\."
              },
              "requiredStates": {
                "const": [
                  "construction",
                  "operational",
                  "damaged",
                  "ruined"
                ]
              }
            }
          }
        }
      }
    }
  }
}
