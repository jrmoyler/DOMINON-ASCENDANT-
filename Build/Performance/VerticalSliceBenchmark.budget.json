{
  "$schema": "VerticalSliceBenchmark.budget.schema.json",
  "schemaVersion": 1,
  "resolution": {"width": 1920, "height": 1080},
  "qualityPreset": "High",
  "referenceHardware": {
    "cpu": "Ryzen 5 5600 or equivalent",
    "gpu": "RTX 3060 or RX 6700 XT class",
    "systemMemoryGiB": 16,
