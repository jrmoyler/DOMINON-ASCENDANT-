# Store Unreal's opaque binary packages in Git LFS.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text

# Canonical content fingerprints must not vary by checkout platform.
Content/DA/Manifests/*.json text eol=lf
Content/Buildings/Presentation/*.json text eol=lf
Content/Characters/Presentation/*.json text eol=lf
Content/VFX/Presentation/*.json text eol=lf
Content/Audio/Presentation/*.json text eol=lf
